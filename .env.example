# API Configuration
EXPO_PUBLIC_API_URL_PRODUCTION=https://shook.party

# Kakao OAuth Configuration
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key

# Android push notifications
# Local builds: point to a git-ignored Firebase google-services.json file.
# EAS builds: create GOOGLE_SERVICES_JSON as a File environment variable.
GOOGLE_SERVICES_JSON=./google-services.json
EXPO_PUBLIC_LOCAL_API_PORT=3000
