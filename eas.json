{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "channel": "development"
    },
    "preview": {
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "channel": "production",
      "prebuildCommand": "npx expo prebuild --clean"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "track",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleId": "aks_@naver.com",
        "ascAppId": "6740028350",
        "appleTeamId": "K82D26JQH7"
      }
    }
  }
}
